<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>businesscockpit-cibseven-adapter-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>businesscockpit-cibseven-adapter-migration-tests</artifactId>
  <packaging>pom</packaging>
  <name>VanillaBP Business Cockpit adapter for CIB seven - Migration tests</name>
  <description>This extension next to the Business Cockpit extension for Camunda 7 in one application, once per platform, the way an application runs while it moves from Camunda 7 to CIB seven.</description>

  <modules>
    <module>spring-boot</module>
    <module>quarkus</module>
  </modules>

  <properties>
    <!-- modules of tests only: nothing to install, publish or document. See decision 5 in the
         repository's DECISIONS.md. -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skip.central.release>true</skip.central.release>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- the Camunda 7 adapter and the Business Cockpit extension for it, which the tests run
         next to this one -->
    <camunda7-adapter.version>2.0.0-SNAPSHOT</camunda7-adapter.version>
    <camunda7-extension.version>0.9.0-SNAPSHOT</camunda7-extension.version>
  </properties>

  <!-- The snapshots of the Camunda 7 adapter are only in the GitHub Packages registry of the
       Camunda Community Hub. Reading it needs a login even for a public package, so a build
       needs a server entry with this id (see CONTRIBUTING.md). The entry goes away once the
       Camunda 7 adapter has a release on Maven Central. -->
  <repositories>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>camunda-community-hub-vanillabp-camunda7-adapter</id>
      <url>https://maven.pkg.github.com/camunda-community-hub/vanillabp-camunda7-adapter</url>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- the profile 'central-portal' of the release parent brings
               central-publishing-maven-plugin, which stages every module of the reactor, even
               one with 'skip.central.release'. The plugin also stops the whole publish when a
               module assigns no file, so each module here builds its empty jar and leaves it
               out here. -->
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <configuration>
            <excludeArtifacts>
              <excludeArtifact>${project.artifactId}</excludeArtifact>
            </excludeArtifacts>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
